rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Calendário mensal legado: avisos, detalhes, materias, fotos e campos de data.
    // A edição aceita claims administrativas e também a conta fixa da própria turma.
    // Hoje só A–E possuem contas reais; as turmas F ficam sem editor até voltarem a existir.
    function signedIn() { return request.auth != null; }
    function editorPorEmail(sala) {
      let email = request.auth.token.get('email', '');
      return (sala == '1ano-a' && email == '1anoa@erempaf.com')
        || (sala == '1ano-b' && email == '1anob@erempaf.com')
        || (sala == '1ano-c' && email == '1anoc@erempaf.com')
        || (sala == '1ano-d' && email == '1anod@erempaf.com')
        || (sala == '1ano-e' && email == '1anoe@erempaf.com')
        || (sala == '2ano-a' && email == '2anoa@erempaf.com')
        || (sala == '2ano-b' && email == '2anob@erempaf.com')
        || (sala == '2ano-c' && email == '2anoc@erempaf.com')
        || (sala == '2ano-d' && email == '2anod@erempaf.com')
        || (sala == '2ano-e' && email == '2anoe@erempaf.com')
        || (sala == '3ano-a' && email == '3anoa@erempaf.com')
        || (sala == '3ano-b' && email == '3anob@erempaf.com')
        || (sala == '3ano-c' && email == '3anoc@erempaf.com')
        || (sala == '3ano-d' && email == '3anod@erempaf.com')
        || (sala == '3ano-e' && email == '3anoe@erempaf.com');
    }
    function editor(sala) {
      return signedIn() && (
        (request.auth.token.get('editorTurmas', []) is list
          && sala in request.auth.token.get('editorTurmas', []))
        || editorPorEmail(sala)
      );
    }
    function validText(value, max) {
      return value is string && value.size() <= max;
    }
    function validDay(day, mes) {
      return day is string && day.matches('^' + mes + '-(0[1-9]|[12][0-9]|3[01])$');
    }
    function validSubjectTextAt(values, i) {
      return values.size() <= i ? true : validText(values[i], 5000);
    }
    function validSubjects(value) {
      let values = value.values();
      return value is map && value.size() <= 12
        && value.keys().hasOnly(['Português','Matemática','História','Geografia','Biologia','Lingua Inglesa','Educação Física','Artes','Filosofia','Quimica','Sociologia','Fisica'])
        && (values.size() <= 2 ? validSubjectTextAt(values, 0) && validSubjectTextAt(values, 1) :
          validSubjectTextAt(values, 0) && validSubjectTextAt(values, 1)
            && validSubjectTextAt(values, 2) && validSubjectTextAt(values, 3)
            && validSubjectTextAt(values, 4) && validSubjectTextAt(values, 5)
            && (values.size() <= 6 ? true : validSubjectTextAt(values, 6)
              && validSubjectTextAt(values, 7) && validSubjectTextAt(values, 8)
              && validSubjectTextAt(values, 9) && validSubjectTextAt(values, 10)
              && validSubjectTextAt(values, 11)));
    }
    function validPhoto(photo, sala, mes, allPhotos, dayPhotos) {
      return photo is string
        ? photo.size() <= 900000 && photo.matches('^data:image/(jpeg|png|webp);base64,.*$')
        : photo is map
          && photo.keys().hasOnly(['img','desc'])
          && validText(photo.img, 900000)
          && photo.img.matches('^data:image/(jpeg|png|webp);base64,.*$')
          && validText(photo.get('desc', ''), 120);
    }
    function validPhotoAt(value, sala, mes, allPhotos, i) {
      return value.size() <= i ? true : validPhoto(value[i], sala, mes, allPhotos, value);
    }
    function validPhotoList(value, sala, mes, allPhotos) {
      return value is list && value.size() <= 6 && (value.size() <= 3
        ? validPhotoAt(value, sala, mes, allPhotos, 0)
          && validPhotoAt(value, sala, mes, allPhotos, 1)
          && validPhotoAt(value, sala, mes, allPhotos, 2)
        : validPhotoAt(value, sala, mes, allPhotos, 0)
          && validPhotoAt(value, sala, mes, allPhotos, 1)
          && validPhotoAt(value, sala, mes, allPhotos, 2)
          && validPhotoAt(value, sala, mes, allPhotos, 3)
          && validPhotoAt(value, sala, mes, allPhotos, 4)
          && validPhotoAt(value, sala, mes, allPhotos, 5));
    }
    function validMonthKeys(keys, mes) {
      return keys.hasOnly([
        mes + '-01', mes + '-02', mes + '-03', mes + '-04', mes + '-05', mes + '-06', mes + '-07',
        mes + '-08', mes + '-09', mes + '-10', mes + '-11', mes + '-12', mes + '-13', mes + '-14',
        mes + '-15', mes + '-16', mes + '-17', mes + '-18', mes + '-19', mes + '-20', mes + '-21',
        mes + '-22', mes + '-23', mes + '-24', mes + '-25', mes + '-26', mes + '-27', mes + '-28',
        mes + '-29', mes + '-30', mes + '-31'
      ]);
    }
    function validDetailAt(values, i) {
      return values.size() <= i ? true : validText(values[i], 20000);
    }
    function validSubjectsAt(values, i) {
      return values.size() <= i ? true : validSubjects(values[i]);
    }
    function validPhotoDayAt(values, sala, mes, allPhotos, i) {
      return values.size() <= i ? true : validPhotoList(values[i], sala, mes, allPhotos);
    }
    function validDetailGroup(values, indexes) {
      return values.size() <= indexes[0] ? true : validDetailAt(values, indexes[0])
        && validDetailAt(values, indexes[1]) && validDetailAt(values, indexes[2])
        && validDetailAt(values, indexes[3]) && validDetailAt(values, indexes[4]);
    }
    function validSubjectsGroup(values, indexes) {
      return values.size() <= indexes[0] ? true : validSubjectsAt(values, indexes[0])
        && validSubjectsAt(values, indexes[1]) && validSubjectsAt(values, indexes[2])
        && validSubjectsAt(values, indexes[3]) && validSubjectsAt(values, indexes[4]);
    }
    function validPhotoDaysGroup(values, sala, mes, allPhotos, indexes) {
      return values.size() <= indexes[0] ? true : validPhotoDayAt(values, sala, mes, allPhotos, indexes[0])
        && validPhotoDayAt(values, sala, mes, allPhotos, indexes[1])
        && validPhotoDayAt(values, sala, mes, allPhotos, indexes[2])
        && validPhotoDayAt(values, sala, mes, allPhotos, indexes[3])
        && validPhotoDayAt(values, sala, mes, allPhotos, indexes[4]);
    }
    // Os limites de keys abaixo são por gravação, não por mês.
    // O documento pode acumular até 23 dias; apenas a quantidade alterada em uma única escrita é limitada
    // para manter a avaliação das Rules previsível e abaixo dos limites do mecanismo.
    function validDetails(value, keys, mes) {
      let values = value.values();
      return value is map && value.size() <= 23 && keys.size() <= 10 && (keys.size() == 0 ? true
        : values.size() <= 1 ? validDetailAt(values, 0) : values.size() <= 5 ? validDetailGroup(values, [0,1,2,3,4]) :
          validDetailAt(values, 0) && validDetailAt(values, 1) && validDetailAt(values, 2)
            && validDetailAt(values, 3) && validDetailAt(values, 4) && validDetailAt(values, 5)
            && validDetailAt(values, 6) && validDetailAt(values, 7) && validDetailAt(values, 8)
            && validDetailAt(values, 9) && validDetailAt(values, 10) && validDetailAt(values, 11)
            && validDetailAt(values, 12) && validDetailAt(values, 13) && validDetailAt(values, 14)
            && validDetailAt(values, 15) && validDetailAt(values, 16) && validDetailAt(values, 17)
            && validDetailAt(values, 18) && validDetailAt(values, 19) && validDetailAt(values, 20)
            && validDetailAt(values, 21) && validDetailAt(values, 22));
    }
    function validSubjectDays(value, keys, mes) {
      let values = value.values();
      return value is map && value.size() <= 23 && keys.size() <= 5 && (keys.size() == 0 ? true
        : values.size() <= 1 ? validSubjectsAt(values, 0) : validSubjectsGroup(values, [0,1,2,3,4]) && (values.size() <= 5 ? true :
          validSubjectsGroup(values, [5,6,7,8,9]) && (values.size() <= 10 ? true :
            validSubjectsGroup(values, [10,11,12,13,14]) && (values.size() <= 15 ? true :
              validSubjectsGroup(values, [15,16,17,18,19]) && validSubjectsAt(values, 20)
                && validSubjectsAt(values, 21) && validSubjectsAt(values, 22)))));
    }
    function validPhotoDays(value, keys, sala, mes) {
      let values = value.values();
      return value is map && value.size() <= 23 && keys.size() <= 3 && (keys.size() == 0 ? true
        : values.size() <= 1 ? validPhotoDayAt(values, sala, mes, value, 0) : validPhotoDaysGroup(values, sala, mes, value, [0,1,2,3,4]) && (values.size() <= 5 ? true :
          validPhotoDaysGroup(values, sala, mes, value, [5,6,7,8,9]) && (values.size() <= 10 ? true :
            validPhotoDaysGroup(values, sala, mes, value, [10,11,12,13,14]) && (values.size() <= 15 ? true :
              validPhotoDaysGroup(values, sala, mes, value, [15,16,17,18,19])
                && validPhotoDayAt(values, sala, mes, value, 20)
                && validPhotoDayAt(values, sala, mes, value, 21)
                && validPhotoDayAt(values, sala, mes, value, 22)))));
    }
    function validCalendarBase() {
      let d = request.resource.data;
      return validText(d.get('avisos', ''), 20000)
        && d.get('detalhes', {}) is map && d.get('detalhes', {}).size() <= 23
        && d.get('materias', {}) is map && d.get('materias', {}).size() <= 23
        && d.get('fotos', {}) is map && d.get('fotos', {}).size() <= 23
        && d.get('revision', 0) is int && d.get('revision', 0) >= 0;
    }
    function validCalendarUpdate(sala, mes) {
      let d = request.resource.data;
      let old = resource.data;
      let changed = d.diff(old).affectedKeys();
      let detailKeys = d.get('detalhes', {}).diff(old.get('detalhes', {})).affectedKeys();
      let subjectKeys = d.get('materias', {}).diff(old.get('materias', {})).affectedKeys();
      let photoKeys = d.get('fotos', {}).diff(old.get('fotos', {})).affectedKeys();
      return changed.hasOnly(['avisos','detalhes','materias','fotos','revision'])
        && validMonthKeys(detailKeys.union(subjectKeys).union(photoKeys), mes)
        && (changed.hasAny(['detalhes'])
          ? validDetails(d.get('detalhes', {}), detailKeys, mes)
          : true)
        && (changed.hasAny(['materias'])
          ? validSubjectDays(d.get('materias', {}), subjectKeys, mes)
          : true)
        && (changed.hasAny(['fotos'])
          ? validPhotoDays(d.get('fotos', {}), photoKeys, sala, mes)
          : true)
        && d.revision == old.get('revision', 0) + 1;
    }
    match /salas/{sala}/calendario/{mes} {
      // A conta correta da turma (ou claim administrativa) pode ler.
      // Escritas do calendário agora passam pelo backend, que também exige a senha
      // guardada em /salas/{sala}.senha. Assim o login sozinho NÃO libera edição.
      allow read: if editor(sala);
      allow create, update, delete: if false;
    }
    // Documento raiz contém senha legada: não deve ser lido pelo navegador.
    match /salas/{sala} { allow read, write: if false; }
    // O navegador só lê. Escritas são feitas exclusivamente pelo backend com Firebase Admin SDK.
    match /cardapio/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /config/{doc} { allow read, write: if false; }
    function validSubscription() {
      let d = request.resource.data;
      return d.keys().hasOnly(['token','turmas','atualizadoEm','ownerUid'])
        && d.ownerUid == request.auth.uid && d.token is string && d.token.size() > 20 && d.token.size() <= 4096
        && d.turmas is list && d.turmas.size() <= 17
        && d.turmas.hasOnly(['1ano-a','1ano-b','1ano-c','1ano-d','1ano-e','1ano-f','2ano-a','2ano-b','2ano-c','2ano-d','2ano-e','3ano-a','3ano-b','3ano-c','3ano-d','3ano-e','3ano-f'])
        && d.atualizadoEm == request.time;
    }
    match /inscricoes/{device} {
      allow read: if false;
      allow create: if signedIn() && validSubscription();
      // Inscrição legada só pode ser reivindicada por quem já possui o token secreto.
      allow update: if signedIn() && validSubscription()
        && (resource.data.get('ownerUid', '') == request.auth.uid
          || (!('ownerUid' in resource.data) && request.resource.data.token == resource.data.token));
      allow delete: if signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
