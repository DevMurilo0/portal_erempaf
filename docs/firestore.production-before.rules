rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /salas/{salaId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Cardápio: qualquer um lê, qualquer um escreve (protegido pela senha no JS)
    match /cardapio/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Config/senha: qualquer um pode LER (para verificar a senha), nunca escrever pelo site
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Inscrições de notificações push por turma
    match /inscricoes/{token} {
      allow read: if false;
      allow write: if request.resource.data.turmas is list
                   && request.resource.data.turmas.size() < 20;
    }
  }
}
